# Comparison application
ACTOR_ID=your-actor-id
HARNESS_REGION=eu-central-1
HARNESS_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:harness/HARNESS_ID
RUNTIME_REGION=eu-west-1
RUNTIME_ARN=arn:aws:bedrock-agentcore:REGION:ACCOUNT_ID:runtime/RUNTIME_ID
RUNTIME_USAGE_LOG_GROUP=bedrock-custom-agent-runtime
RUNTIME_TOKEN_USAGE_LOG_GROUP=bedrock-custom-agent-runtime
RUNTIME_BUILTIN_USAGE_LOG_GROUP=bedrock-custom-agent-runtime
HARNESS_BUILTIN_USAGE_LOG_GROUP=
AGENTCORE_RUNTIME_VCPU_HOUR_USD=0.0895
AGENTCORE_RUNTIME_GB_HOUR_USD=0.00945
AGENTCORE_BUILTIN_VCPU_HOUR_USD=0.0895
AGENTCORE_BUILTIN_GB_HOUR_USD=0.00945
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-6
BEDROCK_STRONG_MODEL_ID=eu.anthropic.claude-sonnet-4-6
BEDROCK_CHEAP_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional when the Harness uses a different Region/geography prefix.
HARNESS_CHEAP_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
MODEL_ROUTING_MODE=auto
# Auto mode uses LiteLLM's LLM classifier in route-only mode. Ministral 3B was
# selected for its measured latency, structured-output reliability, and price.
MODEL_ROUTER_CLASSIFIER_MODEL_ID=mistral.ministral-3-3b-instruct
MODEL_ROUTER_CLASSIFIER_REGION=eu-west-1
MODEL_ROUTER_CLASSIFIER_TIMEOUT_MS=750
MODEL_ROUTER_CLASSIFIER_INPUT_PER_MTOK=0.12
MODEL_ROUTER_CLASSIFIER_OUTPUT_PER_MTOK=0.12
# Prime LiteLLM and the Bedrock classifier connection in a background thread.
MODEL_ROUTER_WARMUP_ENABLED=true
# The app uses the regional rates above, so avoid an optional GitHub lookup at
# startup and use LiteLLM's bundled capability map.
LITELLM_LOCAL_MODEL_COST_MAP=true
# A failed, timed-out, or malformed classifier response falls back to LiteLLM's
# local heuristic scorer. Both policy overrides below are optional.
# Tier -> model group. Only cheap and strong are accepted; unset keeps
# SIMPLE=cheap with MEDIUM, COMPLEX, and REASONING on strong.
# COMPLEXITY_TIERS={"SIMPLE":"cheap","MEDIUM":"strong","COMPLEX":"strong","REASONING":"strong"}
# Normalized score boundaries; unset keeps LiteLLM's defaults
# (simple_medium 0.15, medium_complex 0.35, complex_reasoning 0.60).
# COMPLEXITY_TIER_BOUNDARIES={"simple_medium":0.15,"medium_complex":0.35,"complex_reasoning":0.60}
# Optional list-rate overrides for the economy model used by the cost UI.
BEDROCK_CHEAP_INPUT_PER_MTOK=1.00
BEDROCK_CHEAP_OUTPUT_PER_MTOK=5.00
BEDROCK_CHEAP_CACHE_READ_PER_MTOK=0.10
BEDROCK_CHEAP_CACHE_WRITE_PER_MTOK=1.25
BEDROCK_MAX_TOKENS=4096
THINKING_BUDGET_TOKENS=1024

# Optional OpenSearch + Neptune multi-hop retrieval benchmark.
# Embeddings are stored in OpenSearch; Neptune stores paragraph/entity edges.
# NEPTUNE_GRAPH_ID=g-example
# OPENSEARCH_ENDPOINT=https://example.REGION.aoss.amazonaws.com
# OPENSEARCH_SERVICE=aoss
# MULTIHOP_GRAPH_NAMESPACE=multihop-benchmark-v1
# MULTIHOP_OPENSEARCH_INDEX=multihop-rag-v1
# GRAPH_EMBEDDING_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL_ID=granite-embedding:278m

# Custom agent hosted on AgentCore Runtime
AWS_REGION=eu-west-1
GATEWAY_URL=https://GATEWAY_ID.gateway.bedrock-agentcore.REGION.amazonaws.com/mcp
OFFLOAD_BUCKET=your-agentcore-artifact-bucket
CSV_UPLOAD_BUCKET=your-agentcore-artifact-bucket
CSV_UPLOAD_REGION=eu-west-1
CSV_UPLOAD_URL_TTL_SECONDS=900
OFFLOAD_MAX_TOKENS=2500
OFFLOAD_PREVIEW_TOKENS=800
ENABLE_PROMPT_CACHING=true
ENABLE_THINKING=false

# Optional pin for router telemetry and routing-decision reproducibility. Unset
# reports the installed LiteLLM version, for example litellm-1.96.2.
# MODEL_ROUTER_VERSION=litellm-1.96.2

# Optional: mirror in-process OTEL spans to MLflow without replacing AWS ADOT.
# The endpoint must include /v1/traces. localhost works only for a local agent.
# MLFLOW_OTLP_TRACES_ENDPOINT=http://localhost:5000/v1/traces
# MLFLOW_EXPERIMENT_ID=0

# Durable ledger used by the comparison Streamlit app.
SESSION_COST_DB_PATH=var/session-costs.sqlite3
# Optional separate SQLite database for answer ratings. When omitted, feedback
# uses SESSION_COST_DB_PATH and stores rows in its own agent_feedback table.
# FEEDBACK_DB_PATH=var/session-feedback.sqlite3
# Optional override; otherwise the Harness's underlying Runtime id is resolved.
HARNESS_USAGE_LOG_GROUP=
# Read-only AWS CLI console in the comparison sidebar. Commands execute with
# the UI backend identity and are restricted to selected read operations.
ENABLE_AWS_CLI_CONSOLE=true
AWS_CLI_CONSOLE_TIMEOUT_SECONDS=20
