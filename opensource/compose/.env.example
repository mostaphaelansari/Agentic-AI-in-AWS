# Copy to .env and use newly rotated credentials.
# Never commit real keys.
RAPIDAPI_KEY=replace-with-rotated-key

# Optional Booking.com overrides:
# BOOKING_MCP_URL=https://mcp.rapidapi.com
# RAPIDAPI_HOST=booking-com15.p.rapidapi.com

# Optional: AeroDataBox flight status and airport data MCP.
# Reuses RAPIDAPI_KEY by default when AERODATABOX_RAPIDAPI_KEY is empty.
# AERODATABOX_MCP_URL=https://mcp.rapidapi.com
# AERODATABOX_RAPIDAPI_HOST=aerodatabox.p.rapidapi.com
# AERODATABOX_RAPIDAPI_KEY=replace-with-aerodatabox-key-if-different

# Optional: Air Scraper flight shopping/search MCP.
# Reuses RAPIDAPI_KEY by default when AIR_SCRAPER_RAPIDAPI_KEY is empty.
# AIR_SCRAPER_MCP_URL=https://mcp.rapidapi.com
# AIR_SCRAPER_RAPIDAPI_HOST=sky-scrapper.p.rapidapi.com
# AIR_SCRAPER_RAPIDAPI_KEY=replace-with-air-scraper-key-if-different

# Optional: Geoapify geocoding MCP.
# GEOAPIFY_MCP_URL=https://api.geoapify.com/v1/mcp
# GEOAPIFY_API_KEY=replace-with-geoapify-key

# LiteLLM Auto Router is the default: SIMPLE -> Ollama; all higher tiers -> Kimi.
# Pin MODEL_PROVIDER to kimi or ollama to bypass routing for a comparison run.
# MODEL_PROVIDER=litellm
# MODEL_PROVIDER=ollama
# MODEL_PROVIDER=kimi
# KIMI_API_KEY=replace-with-kimi-key
# KIMI_MODEL_ID=kimi-k2.6
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_TEMPERATURE=1
# LITELLM_ROUTER_MODEL_ID=opensource-auto-router
# LITELLM_ROUTER_SESSION_TTL_SECONDS=600
# Optional: load Ollama into memory before readiness instead of on its first route.
# OLLAMA_WARMUP_ENABLED=true
# OLLAMA_KEEP_ALIVE=10m

# Agent loop runaway guard. Must also be forwarded by docker-compose.yml.
MAX_TOOL_CALLS=12

# Travel-guide retrieval (searchTravelGuides). Qdrant and the reranker are part
# of the default stack; the tool advertises itself only once an index exists.
# Set QDRANT_URL empty to disable the tool entirely.
# QDRANT_URL=http://qdrant:6333
# QDRANT_COLLECTION=travel-rag
# RAG_INDEX_MANIFEST=/data/rag/index-manifest.json
# RAG_RERANK_CANDIDATES=20
# RAG_CATEGORY_FILTER=true
# Set RERANKER_URL empty to skip cross-encoder reranking and use fused
# hybrid order (reported as ranking=HYBRID_FALLBACK).
# RERANKER_URL=http://reranker:80
# RERANKER_MODEL_ID=BAAI/bge-reranker-base
# Embedding model, pulled into the ollama service. granite-embedding:278m is
# multilingual and ~3x faster on CPU than bge-m3; see the README table.
# OLLAMA_EMBED_MODEL_ID=granite-embedding:278m

# Local deterministic prompt/PII/tool guardrails are enabled by default.
# GUARDRAILS_ENABLED=true
# GUARDRAIL_MAX_PROMPT_CHARS=12000

# Optional: disable agent trace export while debugging UI/MLflow issues.
# Leave commented to keep bundled observability enabled.
# MLFLOW_TRACKING_URI=
# OTEL_EXPORTER_OTLP_ENDPOINT=
